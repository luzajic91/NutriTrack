@page "/"
@attribute [Authorize]
@inject IMealService MealService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>NutriTrack - Dashboard</PageTitle>

<div class="meals-container">

    <LoadingOrError IsLoading="_isLoading"
                    ErrorMessage="@(string.IsNullOrEmpty(_loadError) ? null : $"Could not load meal data. {_loadError}")"
                    OnRetry="LoadDataAsync"
                    LoadingText="Loading meals...">
        <!-- Header -->
        <div class="page-header">
            <h1>🍽️ Dashboard</h1>
            <button class="btn btn-primary" @onclick="NavigateToLog">
                + Log Meal
            </button>
        </div>

        <!-- Macro Hero Row: Calories, Protein, Carbs, Fat, Fiber -->
        <section class="macro-hero">
            @foreach (var macro in MacroNutrients)
            {
                <div class="macro-card">
                    <div class="macro-value">
                        @macro.Total.ToString("0.#")<span class="macro-unit">@UnitShort(macro.Unit)</span>
                    </div>
                    <div class="macro-name">@macro.Name</div>
                </div>
            }
            @if (!MacroNutrients.Any())
            {
                <p class="nutrition-empty">No meals logged for this period yet.</p>
            }
        </section>

        <!-- Charts Row -->
        <div class="charts-row">
            <!-- Macro Breakdown donut -->
            @if (MacroNutrients.Count >= 3)
            {
                <div class="chart-card">
                    <h3 class="chart-title">Macro Breakdown</h3>
                    <div class="chart-canvas-wrap">
                        <canvas id="macroDonut"></canvas>
                    </div>
                </div>
            }

            <!-- Micro Nutrients list (Fiber + all non-macro nutrients) -->
            <div class="chart-card">
                <h3 class="chart-title">Other Nutrients</h3>
                @if (MicroNutrients.Any())
                {
                    <div class="micro-list">
                        @foreach (var n in MicroNutrients)
                        {
                            <div class="micro-list-row">
                                <span class="micro-list-value">@n.Total.ToString("0.##") @UnitShort(n.Unit)</span>
                                <span class="micro-list-name">@n.Name</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="nutrition-empty">No other nutrients logged for this period.</p>
                }
            </div>
        </div>

        <!-- Meal History -->
        <section class="history-section">
            <h2>Meal History</h2>

            <!-- Filter bar -->
            <div class="filter-bar">
                <button class="filter-chip @(_activeChip == "today" ? "active" : "")" @onclick='() => SelectChip("today")'>Today</button>
                <button class="filter-chip @(_activeChip == "yesterday" ? "active" : "")" @onclick='() => SelectChip("yesterday")'>Yesterday</button>
                <button class="filter-chip @(_activeChip == "week" ? "active" : "")" @onclick='() => SelectChip("week")'>This Week</button>
                <button class="filter-chip @(_activeChip == "month" ? "active" : "")" @onclick='() => SelectChip("month")'>This Month</button>
                <button class="filter-chip @(_activeChip == "all" ? "active" : "")" @onclick='() => SelectChip("all")'>All Time</button>

                <div class="filter-custom-range">
                    <input type="date"
                           value="@(_customFrom?.ToString("yyyy-MM-dd") ?? "")"
                           @onchange="OnCustomFromChanged" />
                    <span class="filter-sep">–</span>
                    <input type="date"
                           value="@(_customTo?.ToString("yyyy-MM-dd") ?? "")"
                           @onchange="OnCustomToChanged" />
                </div>
            </div>

            @if (!_history.Any())
            {
                <div class="history-empty">
                    <div class="empty-emoji">🥗</div>
                    <p>No meals logged for this period. Hit <strong>Log Meal</strong> to get started!</p>
                </div>
            }
            else
            {
                @foreach (var group in _groupedHistory)
                {
                    <div class="history-date-group">
                        <div class="history-date-label">@FormatDateLabel(group.Key)</div>

                        @foreach (var entry in group.Value)
                        {
                            <div class="meal-card">
                                <div class="meal-card-time">@entry.ConsumedAt.ToLocalTime().ToString("h:mm tt")</div>
                                <ul class="meal-item-list">
                                    @foreach (var item in entry.Items)
                                    {
                                        <li class="meal-item-row">
                                            <span class="meal-item-name">@item.FoodName</span>
                                            <span class="meal-item-grams">@item.Grams.ToString("0.#") g</span>
                                        </li>
                                    }
                                </ul>
                                @if (entry.Macros is { Count: > 0 })
                                {
                                    <div class="meal-card-macros">
                                        @foreach (var m in EntryMacros(entry.Macros))
                                        {
                                            <span>@m.Name: @m.Total.ToString("0.#") @m.Abbreviation</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </section>
    </LoadingOrError>

</div>

@code {
    private bool _isLoading = true;
    private string? _loadError;
    private DailyNutritionSummaryDto? _summary;
    private List<MealEntryDto> _history = new();
    private Dictionary<DateOnly, List<MealEntryDto>> _groupedHistory = new();
    private bool _chartsNeedRender;

    private string _activeChip = "all";
    private DateOnly? _filterFrom;
    private DateOnly? _filterTo;
    private DateOnly? _customFrom;
    private DateOnly? _customTo;

    // Shown in macro hero: Calories + Protein + Carbs + Fat + Fiber
    private static readonly string[] MacroKeywords =
        ["Protein", "Carbohydrate", "Carb", "Fat", "Lipid", "Fiber", "Fibre"];

    // Excluded from micro list: only the pure macros (Fiber intentionally kept in micro list too)
    private static readonly string[] MacroOnlyKeywords =
        ["Protein", "Carbohydrate", "Carb", "Fat", "Lipid"];

    private List<NutrientTotalDto> MacroNutrients => _summary?.Nutrients
        .Where(n => n.Unit == "Kilocalories" || IsMacroGram(n))
        .OrderBy(n => n.Unit == "Kilocalories" ? 0 : 1)
        .ToList() ?? new();

    // Fiber + vitamins + minerals — everything except Calories, Protein, Carbs, Fat
    private List<NutrientTotalDto> MicroNutrients => _summary?.Nutrients
        .Where(n => n.Unit != "Kilocalories" && !IsMacroOnly(n))
        .ToList() ?? new();

    private static bool IsMacroGram(NutrientTotalDto n) =>
        n.Unit == "Grams" && MacroKeywords.Any(k => n.Name.Contains(k, StringComparison.OrdinalIgnoreCase));

    private static bool IsMacroOnly(NutrientTotalDto n) =>
        n.Unit == "Grams" && MacroOnlyKeywords.Any(k => n.Name.Contains(k, StringComparison.OrdinalIgnoreCase));

    private static List<NutrientTotalDto> EntryMacros(List<NutrientTotalDto> nutrients) =>
        nutrients.Where(n => n.Unit == "Kilocalories" || IsMacroGram(n)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartsNeedRender)
        {
            _chartsNeedRender = false;
            await RenderDonutAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _loadError = null;

        ApplyChipDates(_activeChip);

        try
        {
            var today       = DateOnly.FromDateTime(DateTime.Today);
            var summaryFrom = _filterFrom ?? today;
            var summaryTo   = _filterTo   ?? today;

            var summaryTask = MealService.GetSummaryAsync(summaryFrom, summaryTo);
            var historyTask = MealService.GetMealHistoryAsync(from: _filterFrom, to: _filterTo);

            await Task.WhenAll(summaryTask, historyTask);

            _summary        = summaryTask.Result;
            _history        = historyTask.Result;
            _groupedHistory = GroupByDate(_history);
            _chartsNeedRender = true;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadHistoryAndSummaryAsync()
    {
        var today       = DateOnly.FromDateTime(DateTime.Today);
        var summaryFrom = _filterFrom ?? today;
        var summaryTo   = _filterTo   ?? today;

        try
        {
            var summaryTask = MealService.GetSummaryAsync(summaryFrom, summaryTo);
            var historyTask = MealService.GetMealHistoryAsync(from: _filterFrom, to: _filterTo);

            await Task.WhenAll(summaryTask, historyTask);

            _summary          = summaryTask.Result;
            _history          = historyTask.Result;
            _groupedHistory   = GroupByDate(_history);
            _chartsNeedRender = true;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private async Task SelectChip(string chip)
    {
        _activeChip = chip;
        _customFrom = null;
        _customTo   = null;
        ApplyChipDates(chip);
        await LoadHistoryAndSummaryAsync();
    }

    private void ApplyChipDates(string chip)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        (_filterFrom, _filterTo) = chip switch
        {
            "today"     => (today, today),
            "yesterday" => (today.AddDays(-1), today.AddDays(-1)),
            "week"      => (today.AddDays(-(int)today.DayOfWeek + (today.DayOfWeek == DayOfWeek.Sunday ? -6 : 1)), today),
            "month"     => (new DateOnly(today.Year, today.Month, 1), today),
            "all"       => ((DateOnly?)null, (DateOnly?)null),
            _           => (_customFrom, _customTo)
        };
    }

    private async Task OnCustomFromChanged(ChangeEventArgs e)
    {
        _customFrom = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null;
        _activeChip = "custom";
        _filterFrom = _customFrom;
        _filterTo   = _customTo;
        await LoadHistoryAndSummaryAsync();
    }

    private async Task OnCustomToChanged(ChangeEventArgs e)
    {
        _customTo   = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null;
        _activeChip = "custom";
        _filterFrom = _customFrom;
        _filterTo   = _customTo;
        await LoadHistoryAndSummaryAsync();
    }

    private static string UnitShort(string unit) => unit switch
    {
        "Grams"        => "g",
        "Miligrams"    => "mg",
        "Micrograms"   => "µg",
        "Mililiters"   => "mL",
        "Kilocalories" => "kcal",
        _              => unit
    };

    private async Task RenderDonutAsync()
    {
        // Donut shows only Protein, Carbs, Fat — not Fiber
        var gramMacros = MacroNutrients.Where(n => n.Unit == "Grams" && IsMacroOnly(n)).ToList();
        if (gramMacros.Count < 2) return;

        var labels = gramMacros.Select(n => n.Name).ToArray();
        var values = gramMacros.Select(n => (double)n.Total).ToArray();
        string[] colors = ["#667eea", "#f97316", "#22c55e", "#a855f7", "#06b6d4"];

        await JS.InvokeVoidAsync("NutriCharts.renderDonut", "macroDonut",
            labels, values, colors[..Math.Min(labels.Length, colors.Length)]);
    }

    private static Dictionary<DateOnly, List<MealEntryDto>> GroupByDate(List<MealEntryDto> entries)
    {
        return entries
            .GroupBy(e => DateOnly.FromDateTime(e.ConsumedAt.ToLocalTime()))
            .OrderByDescending(g => g.Key)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(e => e.ConsumedAt).ToList());
    }

    private static string FormatDateLabel(DateOnly date)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (date == today) return "Today";
        if (date == today.AddDays(-1)) return "Yesterday";
        return date.ToString("dddd, MMMM d");
    }

    private void NavigateToLog() => Navigation.NavigateTo("/meals/log");
}
