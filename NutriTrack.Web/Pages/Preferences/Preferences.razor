@page "/preferences"
@attribute [Authorize]
@inject IUserPreferencesService PreferencesService
@using NutriTrack.Shared.Models.UserPreferences

<PageTitle>My Preferences - NutriTrack</PageTitle>

<div class="preferences-container">
    <div class="page-header">
        <h1>My Preferences</h1>
    </div>

    <LoadingOrError IsLoading="@_isLoading" ErrorMessage="@_loadError" OnRetry="LoadAsync" LoadingText="Loading preferences...">
        <div class="preferences-card">
            <h2>Body Tracking</h2>
            <div class="pref-rows">
                <EditablePreferenceField Label="Weight" Unit="kg" Value="_prefs.WeightKg"
                                         Decimals="1" Min="0" Max="999" Step="0.1"
                                         OnSave="v => SaveAsync(p => p.WeightKg = AsValue(v))" />
            </div>
        </div>

        <div class="preferences-card">
            <h2>Daily Macro Goals</h2>
            <div class="pref-rows">
                <EditablePreferenceField Label="Calories" Unit="kcal" Value="_prefs.CalorieGoal"
                                         OnSave="v => SaveAsync(p => p.CalorieGoal = AsGoal(v))" />
                <EditablePreferenceField Label="Protein" Unit="g" Value="_prefs.ProteinGoalG"
                                         OnSave="v => SaveAsync(p => p.ProteinGoalG = AsGoal(v))" />
                <EditablePreferenceField Label="Carbs" Unit="g" Value="_prefs.CarbGoalG"
                                         OnSave="v => SaveAsync(p => p.CarbGoalG = AsGoal(v))" />
                <EditablePreferenceField Label="Fat" Unit="g" Value="_prefs.FatGoalG"
                                         OnSave="v => SaveAsync(p => p.FatGoalG = AsGoal(v))" />
                <EditablePreferenceField Label="Fiber" Unit="g" Value="_prefs.FiberGoalG"
                                         OnSave="v => SaveAsync(p => p.FiberGoalG = AsGoal(v))" />
            </div>
        </div>
    </LoadingOrError>
</div>

@code {
    private UserPreferencesDto _prefs = new();
    private bool _isLoading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _prefs = await PreferencesService.GetCurrentUserPreferencesAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load preferences: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Applies a single-field change to a copy, persists it, and commits on success.
    // Returns null on success or an error message to display inline.
    private async Task<string?> SaveAsync(Action<UserPreferencesDto> apply)
    {
        var candidate = Clone(_prefs);
        apply(candidate);

        try
        {
            await PreferencesService.UpdateCurrentUserPreferencesAsync(candidate);
            _prefs = candidate;
            return null;
        }
        catch (Exception ex)
        {
            return $"Failed to save: {ex.Message}";
        }
    }

    // A zero entry clears the value (treated as "not set").
    private static decimal? AsValue(decimal v) => v == 0 ? null : v;
    private static int? AsGoal(decimal v) => v == 0 ? null : (int)v;

    private static UserPreferencesDto Clone(UserPreferencesDto p) => new()
    {
        WeightKg = p.WeightKg,
        CalorieGoal = p.CalorieGoal,
        ProteinGoalG = p.ProteinGoalG,
        CarbGoalG = p.CarbGoalG,
        FatGoalG = p.FatGoalG,
        FiberGoalG = p.FiberGoalG
    };
}
