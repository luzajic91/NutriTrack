@page "/preferences"
@attribute [Authorize]
@inject IUserPreferencesService PreferencesService
@inject IJSRuntime JS
@using NutriTrack.Shared.Models.UserPreferences
@using NutriTrack.Domain.UserPreferences

<PageTitle>My Preferences - NutriTrack</PageTitle>

<div class="preferences-container">
    <div class="page-header">
        <h1>My Preferences</h1>
    </div>

    <LoadingOrError IsLoading="@_isLoading" ErrorMessage="@_loadError" OnRetry="LoadAsync" LoadingText="Loading preferences...">
        <div class="preferences-card">
            <h2>Body Tracking</h2>
            <div class="pref-rows">
                <EditablePreferenceField Label="Weight" Unit="kg" Value="_prefs.WeightKg"
                                         Decimals="1" Min="0" Max="999" Step="0.1"
                                         OnSave="v => SaveAsync(p => p.WeightKg = AsValue(v))" />
            </div>
        </div>

        <div class="preferences-card">
            <h2>Daily Macro Goals</h2>
            <div class="pref-rows">
                <EditablePreferenceField Label="Calories" Unit="kcal" Value="_prefs.CalorieGoal"
                                         OnSave="v => SaveAsync(p => p.CalorieGoal = AsGoal(v))" />
                <EditablePreferenceField Label="Protein" Unit="g" Value="_prefs.ProteinGoalG"
                                         OnSave="v => SaveAsync(p => p.ProteinGoalG = AsGoal(v))" />
                <EditablePreferenceField Label="Carbs" Unit="g" Value="_prefs.CarbGoalG"
                                         OnSave="v => SaveAsync(p => p.CarbGoalG = AsGoal(v))" />
                <EditablePreferenceField Label="Fat" Unit="g" Value="_prefs.FatGoalG"
                                         OnSave="v => SaveAsync(p => p.FatGoalG = AsGoal(v))" />
                <EditablePreferenceField Label="Fiber" Unit="g" Value="_prefs.FiberGoalG"
                                         OnSave="v => SaveAsync(p => p.FiberGoalG = AsGoal(v))" />
            </div>
        </div>

        <div class="preferences-card">
            <h2>Trends</h2>
            <div class="form-group">
                <label class="form-label" for="metricSelect">Metric</label>
                <select id="metricSelect" class="form-control" @bind="_selectedMetric" @bind:after="ReloadHistoryAsync">
                    @foreach (var option in MetricOptions)
                    {
                        <option value="@option.Metric">@option.Label</option>
                    }
                </select>
            </div>

            @if (_history is { Points.Count: > 0 })
            {
                <div class="chart-canvas-wrap">
                    <canvas id="prefHistoryChart"></canvas>
                </div>
            }
            else
            {
                <p class="nutrition-empty">
                    No history yet for @MetricLabel(_selectedMetric). Change this value to start tracking it over time.
                </p>
            }
        </div>
    </LoadingOrError>
</div>

@code {
    private UserPreferencesDto _prefs = new();
    private bool _isLoading = true;
    private string? _loadError;

    private PreferenceMetric _selectedMetric = PreferenceMetric.WeightKg;
    private PreferenceHistoryDto? _history;
    private bool _historyNeedsRender;

    private static readonly (PreferenceMetric Metric, string Label)[] MetricOptions =
    {
        (PreferenceMetric.WeightKg, "Weight (kg)"),
        (PreferenceMetric.CalorieGoal, "Calorie goal (kcal)"),
        (PreferenceMetric.ProteinGoalG, "Protein goal (g)"),
        (PreferenceMetric.CarbGoalG, "Carb goal (g)"),
        (PreferenceMetric.FatGoalG, "Fat goal (g)"),
        (PreferenceMetric.FiberGoalG, "Fiber goal (g)"),
    };

    private static string MetricLabel(PreferenceMetric metric) =>
        MetricOptions.FirstOrDefault(o => o.Metric == metric).Label ?? metric.ToString();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await ReloadHistoryAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_historyNeedsRender)
        {
            _historyNeedsRender = false;
            await RenderHistoryChartAsync();
        }
    }

    private async Task ReloadHistoryAsync()
    {
        try
        {
            _history = await PreferencesService.GetPreferenceHistoryAsync(_selectedMetric);
            _historyNeedsRender = _history.Points.Count > 0;
        }
        catch
        {
            _history = null;
        }
    }

    private async Task RenderHistoryChartAsync()
    {
        if (_history is null || _history.Points.Count == 0) return;

        var labels = _history.Points.Select(p => p.RecordedAt.ToLocalTime().ToString("MMM d")).ToArray();
        var values = _history.Points.Select(p => (double)p.Value).ToArray();

        await JS.InvokeVoidAsync("NutriCharts.renderLine",
            "prefHistoryChart", labels, values, MetricLabel(_selectedMetric));
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _prefs = await PreferencesService.GetCurrentUserPreferencesAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load preferences: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Applies a single-field change to a copy, persists it, and commits on success.
    // Returns null on success or an error message to display inline.
    private async Task<string?> SaveAsync(Action<UserPreferencesDto> apply)
    {
        var candidate = Clone(_prefs);
        apply(candidate);

        try
        {
            await PreferencesService.UpdateCurrentUserPreferencesAsync(candidate);
            _prefs = candidate;
            await ReloadHistoryAsync();
            return null;
        }
        catch (Exception ex)
        {
            return $"Failed to save: {ex.Message}";
        }
    }

    // A zero entry clears the value (treated as "not set").
    private static decimal? AsValue(decimal v) => v == 0 ? null : v;
    private static int? AsGoal(decimal v) => v == 0 ? null : (int)v;

    private static UserPreferencesDto Clone(UserPreferencesDto p) => new()
    {
        WeightKg = p.WeightKg,
        CalorieGoal = p.CalorieGoal,
        ProteinGoalG = p.ProteinGoalG,
        CarbGoalG = p.CarbGoalG,
        FatGoalG = p.FatGoalG,
        FiberGoalG = p.FiberGoalG
    };
}
