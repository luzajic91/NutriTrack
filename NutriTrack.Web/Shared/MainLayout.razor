@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">Welcome, @context.User.Identity?.Name</span>
                    <a href="/logout" class="btn btn-outline-primary btn-sm">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-outline-light btn-sm">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>