@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // Capture current URL (where user tried to go)
        var returnUrl = Navigation.Uri;

        // Escape it for use in query string
        var encodedReturnUrl = Uri.EscapeDataString(returnUrl);

        // Redirect to login with return URL
        // Example: User tried /recipes → Redirect to /login?returnUrl=https://localhost:5000/recipes
        Navigation.NavigateTo($"/login?returnUrl={encodedReturnUrl}");
    }
}